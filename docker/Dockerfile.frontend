FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/

COPY requirements.frontend.txt .
RUN pip install --no-cache-dir -r requirements.frontend.txt --index-url ${PIP_INDEX}

COPY frontend ./frontend

EXPOSE 8501
CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", \
     "--server.address=0.0.0.0", "--server.headless=true", "--browser.gatherUsageStats=false"]
